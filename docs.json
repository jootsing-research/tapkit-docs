    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://tapkit.ai/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
