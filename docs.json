              "examples"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "security"
            ]
          }
        ]
      },
      {
        "tab": "Integrations",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "integrations/overview"
            ]
          },
          {
            "group": "Anthropic",
            "pages": [
              "integrations/claude-code",
              "integrations/claude-app"
            ]
          },
          {
            "group": "OpenAI",
            "pages": [
              "integrations/codex-cli",
              "integrations/codex-app"
            ]
          },
          {
            "group": "Everywhere Else",
            "pages": [
              "integrations/mcp",
              "integrations/skills"
            ]
          }
        ]
      },
