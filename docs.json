              "api-reference/triple-tap",
              "api-reference/tap-and-hold",
              "api-reference/flick",
              "api-reference/drag",
              "api-reference/hold-and-drag"
            ]
          },
          {
            "group": "Keyboard & Buttons",
            "pages": [
              "api-reference/type",
              "api-reference/keypress",
              "api-reference/home"
            ]
